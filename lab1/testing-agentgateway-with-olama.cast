[0.648, "o", "\u001b[7mcurl http://localhost:3000/v1/chat/completions \\\u001b[27m\r\r\n\u001b[7m  -H \"content-type: application/json\" \\\u001b[27m\u001b[K\r\r\n\u001b[7m  -d '{\u001b[27m\u001b[K\r\r\n\u001b[7m    \"model\": \"llama3.2\",\u001b[27m\u001b[K\r\r\n\u001b[7m    \"messages\": [\u001b[27m\u001b[K\r\r\n\u001b[7m      {\"role\": \"user\", \"content\": \"Hello! Tell me about Ollama in one sentence.\"}\u001b[27m\u001b[K\r\r\n\u001b[7m    ]\u001b[27m\u001b[K\r\r\n\u001b[7m  }' | jq\u001b[27m\u001b[K"]
[0.572, "o", "\u001b[7A\u001b[22C\u001b[27mc\u001b[27mu\u001b[27mr\u001b[27ml\u001b[27m \u001b[27mh\u001b[27mt\u001b[27mt\u001b[27mp\u001b[27m:\u001b[27m/\u001b[27m/\u001b[27ml\u001b[27mo\u001b[27mc\u001b[27ma\u001b[27ml\u001b[27mh\u001b[27mo\u001b[27ms\u001b[27mt\u001b[27m:\u001b[27m3\u001b[27m0\u001b[27m0\u001b[27m0\u001b[27m/\u001b[27mv\u001b[27m1\u001b[27m/\u001b[27mc\u001b[27mh\u001b[27ma\u001b[27mt\u001b[27m/\u001b[27mc\u001b[27mo\u001b[27mm\u001b[27mp\u001b[27ml\u001b[27me\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27ms\u001b[27m \u001b[27m\\\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m-\u001b[27mH\u001b[27m \u001b[27m\"\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m-\u001b[27mt\u001b[27my\u001b[27mp\u001b[27me\u001b[27m:\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27ml\u001b[27mi\u001b[27mc\u001b[27ma\u001b[27mt\u001b[27mi\u001b[27mo\u001b[27mn\u001b[27m/\u001b[27mj\u001b[27ms\u001b[27mo\u001b[27mn\u001b[27m\"\u001b[27m \u001b[27m\\\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m-\u001b[27md\u001b[27m \u001b[27m'\u001b[27m{\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mm\u001b[27mo\u001b[27md\u001b[27me\u001b[27ml\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27ml\u001b[27ml\u001b[27ma\u001b[27mm\u001b[27ma\u001b[27m3\u001b[27m.\u001b[27m2\u001b[27m\"\u001b[27m,\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m\"\u001b[27mm\u001b[27me\u001b[27ms\u001b[27ms\u001b[27ma\u001b[27mg\u001b[27me\u001b[27ms\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m[\u001b[1B\r\u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m \u001b[27m{\u001b[27m\"\u001b[27mr\u001b[27mo\u001b[27ml\u001b[27me\u001b[27m\"\u001b[27m:\u001b[27m \u001b[27m\"\u001b[27mu\u001b[27ms\u001b[27me\u001b[27mr\u001b[27m\"\u001b[27m,\u001b[27m \u001b[27m\"\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mn"]
